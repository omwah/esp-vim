menu "esp-vim git"

    config ESP_VIM_GIT_SELFTEST
        bool "libgit2 feasibility self-test (stage 6z)"
        default n
        help
            Links libgit2 and starts a task that waits for /fat/gittest.conf,
            then runs init, commit, status, clone, fetch and push against the
            URLs in it and prints the results (GIT-ST lines) with time, heap
            and stack figures. Driven by esp-vim/test/git.py. Not for use:
            it decides how Phase 8 is built (docs/PLAN.md).

    config ESP_VIM_GIT_SELFTEST_STACK
        int "Self-test task stack (bytes)"
        depends on ESP_VIM_GIT_SELFTEST
        default 32768

endmenu
