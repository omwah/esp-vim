# Bracket every writable section of libvim.a -- Vim itself plus the port's
# shims -- so a new Vim session can restore it to power-on state after :q
# (esp_vim_session_begin in port/esp_shims.c):
#
#   _vim_data_start .. _vim_data_end   initialised data, restored from a snapshot
#   _vim_bss_start  .. _vim_bss_end    zero-initialised data, zeroed
#
# ESP-IDF's data/bss schemes cover .data+ and .bss+ only. On RISC-V the
# component is built with -msmall-data-limit=0 (CMakeLists.txt) so nothing is
# placed in .sdata/.sbss, which these brackets would miss.
#
# On the ESP32-S3 the zero-initialised part goes to PSRAM (ESP_VIM_BSS_IN_PSRAM):
# internal RAM there cannot hold Vim's 40 KB of .bss, a 64 KB task stack and
# WiFi. Only the Vim task (and the file wrappers, never from an interrupt or
# with the cache off) touch it, so external memory is safe.
# The default scheme, with Vim's zero-initialised data in external RAM. It
# retargets the standard "bss" fragment (not a new one), so the generator also
# excludes libvim.a from the internal .bss catch-all.
[scheme:vim_psram_bss]
entries:
    text -> flash_text
    rodata -> flash_rodata
    data -> dram0_data
    bss -> extern_ram
    common -> extern_ram

# A P4 before revision 3 (the Tab5's) has a second internal data region, and
# ESP-IDF makes its dram0_data and dram0_bss placements in both, linking with
# --enable-non-contiguous-regions: Vim's sections were split between the two,
# each bound below was assigned twice, the second value won, and a new session
# left the low part (vimvars among it) as the last one had left it. There they
# go to dram1_data and dram1_bss instead, targets only the high region has
# (patches/esp-idf/0003-esp_system-rev-less-v3-high-region-targets.patch):
# one placement each, whole. scripts/check-vim-sections.py checks every build.
[scheme:vim_high_region]
entries:
    text -> flash_text
    rodata -> flash_rodata
    data -> dram1_data
    bss -> dram1_bss
    common -> dram1_bss

[mapping:vim]
archive: libvim.a
entries:
    if ESP32P4_SELECTS_REV_LESS_V3 = y:
        * (vim_high_region);
            data -> dram1_data SURROUND(vim_data),
            bss -> dram1_bss SURROUND(vim_bss)
    elif ESP_VIM_BSS_IN_PSRAM = y:
        * (vim_psram_bss);
            data -> dram0_data SURROUND(vim_data),
            bss -> extern_ram SURROUND(vim_bss)
    else:
        * (default);
            data -> dram0_data SURROUND(vim_data),
            bss -> dram0_bss SURROUND(vim_bss)
