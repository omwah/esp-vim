menu "esp-vim touch"

    config ESP_VIM_TOUCH
        bool "Capacitive touch panel on I2C"
        default n
        help
            Touches become mouse events in Vim (tap, drag, swipe to scroll)
            and drive the Bluetooth pairing overlay. The FT6336G defaults
            below are the Hosyond ES3C28P's (docs/PLAN.md, 10b); the GT911
            ones the Freenove FNK0115's.

    if ESP_VIM_TOUCH

    choice ESP_VIM_TOUCH_CHIP
        prompt "Controller"
        default ESP_VIM_TOUCH_FT6336
    config ESP_VIM_TOUCH_FT6336
        bool "FT6336G / FT6x06"
    config ESP_VIM_TOUCH_GT911
        bool "GT911"
    config ESP_VIM_TOUCH_BOARD
        bool "The board's own (esp_board: M5Stack Tab5)"
        depends on ESP_VIM_BOARD_TAB5
        help
            Whichever controller goes with the fitted panel (GT911, or the
            ST7123/ST7121's own), through Espressif's board support package,
            polled. Its points are turned the way the display turns the
            picture (ESP_VIM_DISP_ROTATION); the pins, address and
            swap/mirror settings below don't apply.
    endchoice

    config ESP_VIM_TOUCH_SDA
        int "SDA GPIO"
        default 19 if ESP_VIM_TOUCH_GT911
        default 16
    config ESP_VIM_TOUCH_SCL
        int "SCL GPIO"
        default 20 if ESP_VIM_TOUCH_GT911
        default 15
    config ESP_VIM_TOUCH_INT
        int "Interrupt GPIO"
        default 18 if ESP_VIM_TOUCH_GT911
        default 17
    config ESP_VIM_TOUCH_RST
        int "Reset GPIO (active low; -1: none)"
        default 38 if ESP_VIM_TOUCH_GT911
        default 18
    config ESP_VIM_TOUCH_ADDR
        hex "I2C address"
        default 0x5D if ESP_VIM_TOUCH_GT911
        default 0x38
        help
            A GT911 takes 0x5D or 0x14, chosen by its INT line at reset;
            with a reset pin, the driver selects the one given here.
            Without one (-1), this is tried first and then the other.

    config ESP_VIM_TOUCH_ANY_EDGE
        bool "Wake on either edge of INT"
        depends on !ESP_VIM_TOUCH_BOARD
        default n
        help
            For a GT911 whose INT mode isn't known: pulses either way, or a
            level held while touched (the LilyGo T-Deck Plus's differ from
            unit to unit). Off, a falling edge wakes the touch task.

    config ESP_VIM_TOUCH_GT911_SWITCH_REF
        int "GT911 Module_Switch1 the swap and mirrors are right for (-1: ignore it)"
        depends on ESP_VIM_TOUCH_GT911
        range -1 255
        default -1
        help
            A GT911's own configuration can reverse its axes and swap them
            (register 0x804D: bit 7 Driver_Reversal, bit 6 Sensor_Reversal,
            bit 3 X2Y), and panels of one board can differ there: the LilyGo
            T-Deck Plus's left and right from batch to batch. Set this to
            the value (the boot log shows it) on a panel the swap and mirrors
            below are right for; a panel whose bits differ gets those axes
            turned back. :EspTouch sets a turn of its own over all this.

    config ESP_VIM_TOUCH_WIDTH
        int "Screen width, as mounted"
        default 1280 if ESP_VIM_TOUCH_BOARD
        default 800 if ESP_VIM_TOUCH_GT911
        default 320
    config ESP_VIM_TOUCH_HEIGHT
        int "Screen height, as mounted"
        default 720 if ESP_VIM_TOUCH_BOARD
        default 480 if ESP_VIM_TOUCH_GT911
        default 240

    # The panel reports portrait coordinates. The ES3C28P, landscape with the
    # USB port on the right (as esp_display draws it): swap, then mirror X.
    config ESP_VIM_TOUCH_SWAP_XY
        bool "Swap X and Y"
        default n if ESP_VIM_TOUCH_GT911 || ESP_VIM_TOUCH_BOARD
        default y
    config ESP_VIM_TOUCH_MIRROR_X
        bool "Mirror X (after swapping)"
        default n if ESP_VIM_TOUCH_GT911 || ESP_VIM_TOUCH_BOARD
        default y
    config ESP_VIM_TOUCH_MIRROR_Y
        bool "Mirror Y (after swapping)"
        default n

    endif

endmenu
