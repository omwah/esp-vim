menu "esp-vim touch"

    config ESP_VIM_TOUCH
        bool "Capacitive touch panel on I2C"
        default n
        help
            Touches become mouse events in Vim (tap, drag, swipe to scroll)
            and drive the Bluetooth pairing overlay. The FT6336G defaults
            below are the Hosyond ES3C28P's (docs/PLAN.md, 10b); the GT911
            ones the Freenove FNK0115's.

    if ESP_VIM_TOUCH

    choice ESP_VIM_TOUCH_CHIP
        prompt "Controller"
        default ESP_VIM_TOUCH_FT6336
    config ESP_VIM_TOUCH_FT6336
        bool "FT6336G / FT6x06"
    config ESP_VIM_TOUCH_GT911
        bool "GT911"
    endchoice

    config ESP_VIM_TOUCH_SDA
        int "SDA GPIO"
        default 19 if ESP_VIM_TOUCH_GT911
        default 16
    config ESP_VIM_TOUCH_SCL
        int "SCL GPIO"
        default 20 if ESP_VIM_TOUCH_GT911
        default 15
    config ESP_VIM_TOUCH_INT
        int "Interrupt GPIO"
        default 18 if ESP_VIM_TOUCH_GT911
        default 17
    config ESP_VIM_TOUCH_RST
        int "Reset GPIO (active low; -1: none)"
        default 38 if ESP_VIM_TOUCH_GT911
        default 18
    config ESP_VIM_TOUCH_ADDR
        hex "I2C address"
        default 0x5D if ESP_VIM_TOUCH_GT911
        default 0x38
        help
            A GT911 takes 0x5D or 0x14, chosen by its INT line at reset;
            with a reset pin, the driver selects the one given here.

    config ESP_VIM_TOUCH_WIDTH
        int "Screen width, as mounted"
        default 800 if ESP_VIM_TOUCH_GT911
        default 320
    config ESP_VIM_TOUCH_HEIGHT
        int "Screen height, as mounted"
        default 480 if ESP_VIM_TOUCH_GT911
        default 240

    # The panel reports portrait coordinates. The ES3C28P, landscape with the
    # USB port on the right (as esp_display draws it): swap, then mirror X.
    config ESP_VIM_TOUCH_SWAP_XY
        bool "Swap X and Y"
        default n if ESP_VIM_TOUCH_GT911
        default y
    config ESP_VIM_TOUCH_MIRROR_X
        bool "Mirror X (after swapping)"
        default n if ESP_VIM_TOUCH_GT911
        default y
    config ESP_VIM_TOUCH_MIRROR_Y
        bool "Mirror Y (after swapping)"
        default n

    endif

endmenu
