# Settings common to every target. Chip-specific settings live in
# sdkconfig.defaults.<target> (esp32p4, esp32s3), which ESP-IDF applies on top
# of this file automatically for that target. The target itself is chosen with
# `idf.py set-target`, never here -- that would force every build to one chip.

# 16 MB flash, custom partition table (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# POSIX console behaviour Vim relies on (docs/PHASE1.md).
CONFIG_VFS_SUPPORT_TERMIOS=y
CONFIG_VFS_SUPPORT_SELECT=y
CONFIG_VFS_SUPPORT_DIR=y

# Long filenames and UTF-8 names on FAT.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y

# PSRAM holds Vim's whole heap (docs/PHASE4.md). The size is detected from the
# device; under esp-emu it is set with --psram-size.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y

# Console on UART0, which esp-emu bridges to stdio or --uart-tcp.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Panic output to UART only. With a USB-Serial-JTAG secondary console the panic
# handler spins forever on a TX FIFO nothing drains (the emulator, or a board
# with no USB host attached), so a crash looked like a silent hang.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# app_main only sets up and spawns the Vim task, which has its own stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Optimize for size: the app partition cannot be resized once /fat holds data.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# :EspTasks lists every FreeRTOS task (uxTaskGetSystemState).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# TLS (https downloads, later the web server and SSH) allocates tens of KB per
# connection. On the ESP32-S3 internal RAM is ~100 KB free, so mbedTLS takes
# its memory from PSRAM.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# :EspSshKeygen writes the private key as PEM (mbedTLS PK + PEM writers).
CONFIG_MBEDTLS_PEM_WRITE_C=y
# libssh2's own debug logging costs flash and is never switched on at runtime.
# CONFIG_LIBSSH2_DEBUG_ENABLE is not set

# The web interface serves HTTPS (esp_https_server). Its certificate is made
# with mbedTLS's X.509 writer, which ESP-IDF always enables.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
