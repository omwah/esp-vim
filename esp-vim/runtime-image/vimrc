" System vimrc for Vim on ESP32-P4 / M5Stack Tab5.
"
" Vim sources this ($VIM/vimrc, and $VIM is /vimrt) before the user's own vimrc
" and, when there is none, before defaults.vim. It sets what is different about
" THIS platform; editing taste is left to defaults.vim and the user.
"
" Put personal settings in /fat/.vimrc -- /vimrt is a read-only partition.

" No locale support on the device, so Vim would otherwise default to latin1.
set encoding=utf-8
scriptencoding utf-8

" The medium is wear-levelled SPI flash. Swap files, backups, undo files and
" viminfo would all be written continuously, and FATFS reports st_ino = 0, so
" Vim's same-file detection for backups is blind anyway (docs/PHASE1.md).
set noswapfile
set nobackup nowritebackup
set noundofile
set viminfo=

" Files arrive over SCP, SFTP, USB and the web interface. Modelines let a file
" set options when it is opened, which is not something to trust by default.
set nomodeline

" The backtracking regexp engine. Measured on stock desktop Vim built from the
" same source, the first file opened costs 26.5 MB under the default automatic
" engine (compiling filetype.vim's ~1600 autocmd patterns as NFA programs) and
" 0.6 MB under this one. On the P4 the difference is about 19 MB of the 32 MB of
" PSRAM. It does not recurse on the C stack -- regexp_bt.c keeps its state on a
" heap "regstack" capped by 'maxmempattern' -- and pathological patterns are cut
" off by the regexp timeout, which the port implements (esp_shims.c, setitimer).
set regexpengine=1

" Colour. The builtin xterm termcap (term.c, builtin_xterm) has no colour
" entries at all: an ordinary build gets them from terminfo, which this one does
" not have (HAVE_TGETENT is off). Without this, t_Co is 0, defaults.vim never
" turns syntax on, and highlighting would be monochrome regardless.
"
" Both terminals Vim talks to here do 256 colours: a host terminal over the
" UART, and the Tab5's libvterm-based display console. Vim's term_color()
" upgrades the plain "\e[3%dm" forms to 38;5;N / 48;5;N itself above 15.
"
" ORDER MATTERS: t_AF before t_Co. Setting t_Co makes Vim recompute its default
" highlight colours at once, and it picks xterm colour numbering only if t_AF
" (ending in "m") is already set -- otherwise PC numbering, where 1 is blue, and
" every default group (NonText, Directory, ...) comes out red instead of blue.
if &term =~# '^xterm'
  let &t_AB = "\<Esc>[4%dm"
  let &t_AF = "\<Esc>[3%dm"
  set t_Co=256
endif

" Mouse: SGR reporting. It is the only xterm mouse protocol that works beyond
" column 223 (the Tab5 console is 160 columns at 8 px, wider in future), and
" both terminals used here -- host terminals and libvterm -- support it.
" Pinned rather than detected: detection needs a terminal version response,
" which a scripted or piped session never sends.
set ttymouse=sgr

" Quiet syntax, filetype plugin and indent loading. The runtime image is a
" curated slice of Vim's (scripts/make-runtime-image.py), and some scripts reach
" for a file it leaves out -- markdown's syntax loads html's, which includes
" syntax/vb.vim and xml's dtd.vim; its ftplugin calls htmlcomplete#...() -- so
" opening such a file stopped at a screen of errors, though the rest of the
" script still ran. Each loader's autocommand is put back as it was, only under
" :silent!, once the loader is sourced: highlighting works as far as it can,
" and no error shows. The cost: real errors in these scripts are silent too,
" your own in /fat/.vim included; v:errmsg keeps the last one.
function! s:QuietLoader(file, group, func) abort
  let info = getscriptinfo({'name': '[/\\]' .. a:file .. '$'})
  if empty(info)
    return
  endif
  let call = 'silent! call <SNR>' .. info[0].sid .. '_' .. a:func .. '()'
  let event = a:func ==# 'SynSet' ? 'Syntax' : 'FileType'
  " The loader's own group ("END" selects the default one, synload's): inside
  " an autocommand, a bare :autocmd would act on esp_quiet_loaders.
  execute 'augroup' (empty(a:group) ? 'END' : a:group)
  execute 'autocmd!' event '*'
  execute 'autocmd' event '*' call
  augroup END
endfunction
augroup esp_quiet_loaders
  autocmd!
  autocmd SourcePost */syntax/synload.vim call s:QuietLoader('syntax[/\\]synload\.vim', '', 'SynSet')
  autocmd SourcePost */ftplugin.vim call s:QuietLoader('ftplugin\.vim', 'filetypeplugin', 'LoadFTPlugin')
  autocmd SourcePost */indent.vim call s:QuietLoader('indent\.vim', 'filetypeindent', 'LoadIndent')
augroup END

" No Vim-script highlighting of code examples in help. syntax/help.vim loads
" all of syntax/vim.vim for ">vim" examples and again for ">vim9" ones: :help
" then held 1.9 MB of Vim's heap instead of 0.7 MB, most of the ~2.4 MB an
" ESP32-S3 board gives Vim, and out-of-memory errors followed. The help shipped
" here has plain ">" examples only, which are still highlighted. To have it
" back, set it in /fat/.vimrc: let g:help_example_languages = #{vim: 'vim'}
let g:help_example_languages = {}

" A display console (the ES3C28P's panel): light text on black. It can't answer
" Vim's question about its background colour, so say it here, and make the
" Visual selection visible: Vim's dark default, the reverse of black on grey,
" is barely different from plain text on this panel. Override either in
" /fat/.vimrc (after a colorscheme, set Visual there too).
"
" A black-and-white one (the RLCD-4.2's): black on white, and no colours at all.
" With t_Co at 0 Vim highlights as for a monochrome terminal, with its "term="
" attributes -- keywords and comments bold, constants and types underlined, a
" Visual selection reversed -- which the display draws. defaults.vim switches
" syntax on only when there are colours, so it's switched on here. The serial
" console then sees the same; "set t_Co=256" in /fat/.vimrc has colours back.
if exists('*esp_display') && esp_display().active
  if esp_display().mono
    set t_Co=0
    set background=light
    syntax on
  else
    set background=dark
    highlight Visual cterm=NONE ctermfg=NONE ctermbg=24
  endif
endif

" The microSD card, when one is mounted (boards with a slot):
"
"   - Vim starts in /sd rather than /fat: it is the bigger place, and new
"     files land there. To start elsewhere, :cd in /fat/.vimrc, which is
"     sourced after this file.
"   - /sd/vim goes on 'runtimepath', after /fat/.vim and before /vimrt. It is
"     where the full help goes (:help esp-sd-help; scripts/sd-help.py, on a
"     computer, writes it) and where spell dictionaries are downloaded. Like
"     /fat/.vim, its plugin/ scripts run at startup.
"   - /sd/vim/vimrc, if the card has one, is your vimrc too, so settings go
"     with the card from one device to another: Vim sources it, then
"     /fat/.vimrc (or /fat/.vim/vimrc), whose device-specific settings so
"     win. Vim reads $VIMINIT, when set, instead of looking for a vimrc of
"     its own, and both count as yours: defaults.vim is not loaded, as
"     whenever there is a vimrc. $MYVIMRC is the card's.
"   - Spell downloads go to g:esp_spell_dir, /sd/vim/spell; set it in
"     /fat/.vimrc to change that, or to '' for Vim's own choice. It must be
"     a "spell" folder in a 'runtimepath' entry, or Vim won't find the
"     dictionaries it downloads.
" No "\" line continuation in this file: Vim reads it while 'compatible' is
" still set, and 'cpoptions' then has "C", which turns continuation off.
let s:viminit = 'source /sd/vim/vimrc'
let s:viminit .= ' | if filereadable(expand("~/.vimrc")) | source ~/.vimrc'
let s:viminit .= ' | elseif filereadable(expand("~/.vim/vimrc")) | source ~/.vim/vimrc | endif'
" The environment outlives a session (:q starts a new one): not set from the
" last one, when the card has gone or has no vimrc now.
if $VIMINIT ==# s:viminit
  unlet $VIMINIT
  if $MYVIMRC ==# '/sd/vim/vimrc'
    unlet $MYVIMRC
  endif
endif
if exists('*esp_sd') && esp_sd().mounted
  let s:rtp = split(&runtimepath, ',')
  let s:at = index(map(copy(s:rtp), 'expand(v:val)'), expand($VIMRUNTIME))
  call insert(s:rtp, '/sd/vim', max([s:at, 0]))
  let &runtimepath = join(s:rtp, ',')
  unlet s:rtp s:at
  let g:esp_spell_dir = '/sd/vim/spell'
  cd /sd
  if filereadable('/sd/vim/vimrc')
    let $VIMINIT = s:viminit
    let $MYVIMRC = '/sd/vim/vimrc'
  endif
endif
unlet s:viminit

" Vim's spellfile.vim offers the "spell" folders that exist on 'runtimepath'
" and creates one in the first writable entry only when there are none, so
" where a download lands depends on what happens to exist. Once it is loaded,
" its choice is replaced by one that puts g:esp_spell_dir first, creating it,
" and still offers any other folder already in use.
function! s:SpellDirChoices() abort
  function! spellfile#GetDirChoices() abort
    let dirlist = []
    let own = get(g:, 'esp_spell_dir', '')
    if !empty(own)
      silent! call mkdir(own, 'p')
      if filewritable(own) == 2
        call add(dirlist, own)
      endif
    endif
    for dir in globpath(&runtimepath, 'spell', 0, 1)
      if filewritable(dir) == 2 && index(dirlist, dir) < 0
        call add(dirlist, dir)
      endif
    endfor
    let choices = '&Cancel'
    for i in range(len(dirlist))
      let choices .= "\n&" . (i + 1)
    endfor
    return [dirlist, choices]
  endfunction
endfunction
augroup esp_spell_dir
  autocmd!
  autocmd SourcePost */autoload/spellfile.vim call s:SpellDirChoices()
augroup END
