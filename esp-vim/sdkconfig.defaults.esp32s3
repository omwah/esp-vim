# ESP32-S3 build variant (docs/PLAN.md: "target S3 as a build variant from
# Phase 5 onward, not a fork"). Assumes the common N16R8 module shape:
# 16 MB flash, 8 MB octal PSRAM.

# Octal PSRAM (the R8 in N16R8); quad-PSRAM boards would use SPIRAM_MODE_QUAD.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The S3 defaults to 160 MHz; it is rated for 240.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Vim's heap lives in PSRAM, so give the data cache in front of it more room.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# WiFi (esp_net): its and lwIP's buffers in PSRAM -- internal RAM on the S3 is
# about 100 KB free, and the radio alone would take half of it.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Internal RAM is what WiFi really costs on the S3: without these the Vim task's
# 64 KB stack no longer fits and boot fails ("cannot create the Vim task").
# WiFi's and lwIP's IRAM speed-ups take SRAM the S3 shares between code and
# data, and static RX buffers are internal; an editor's traffic needs neither.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_LWIP_IRAM_OPTIMIZATION is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_RX_BA_WIN=6
# ... and Vim's .bss goes to PSRAM (ESP_VIM_BSS_IN_PSRAM, components/vim/linker.lf).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Bluetooth LE (esp_ble): NimBLE, started on first use -- or at boot when a
# keyboard is bonded -- with the host's memory in PSRAM. Observer (scanning) and
# central (keyboards: Phase 11, via ESP-IDF's HID host), with bonding kept in NVS.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# ESP-IDF builds its NimBLE HID *host* (esp_hid's nimble_hidh.c) only with this
# option, though it's named for the HID service -- and that sits behind the GATT
# server, which needs the peripheral role. None of the three is used otherwise.
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_HID_SERVICE=y
# The controller's code in flash, not internal RAM: about 20 KB of IRAM that the
# web server's task otherwise can't find (ESP_ERR_HTTPD_TASK). The cost is that
# Bluetooth may falter while flash is being erased -- and nothing writes flash
# during a scan, which blocks the editor.
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
