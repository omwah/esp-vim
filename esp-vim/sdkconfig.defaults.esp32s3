# ESP32-S3 build variant (docs/PLAN.md: "target S3 as a build variant from
# Phase 5 onward, not a fork"). Assumes the common N16R8 module shape:
# 16 MB flash, 8 MB octal PSRAM.

# Octal PSRAM (the R8 in N16R8); quad-PSRAM boards would use SPIRAM_MODE_QUAD.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# The S3 defaults to 160 MHz; it is rated for 240.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Vim's heap lives in PSRAM, so give the data cache in front of it more room.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
