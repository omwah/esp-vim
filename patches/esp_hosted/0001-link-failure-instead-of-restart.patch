@@ -48,6 +48,28 @@
 
 static uint8_t transport_state = TRANSPORT_INACTIVE;
 
+/* esp-vim: a co-processor that stops answering marks the link failed,
+ * instead of restarting the host or aborting, and the transport task that
+ * found it stops there. Calls fail from then on (no transport); a restart of
+ * the host tries again. */
+static volatile uint8_t link_failed;
+
+void hosted_link_failed(const char *why)
+{
+	if (!link_failed) {
+		link_failed = 1;
+		ESP_LOGE(TAG, "co-processor not responding (%s): link down until restart", why);
+	}
+	transport_state = TRANSPORT_INACTIVE;
+	for (;;)
+		g_h.funcs->_h_sleep(3600);
+}
+
+uint8_t esp_hosted_link_failed(void)
+{
+	return link_failed;
+}
