diff --git a/src/os_unix.c b/src/os_unix.c
index d036633..03394c9 100644
--- a/src/os_unix.c
+++ b/src/os_unix.c
@@ -4504,15 +4504,16 @@ query_terminal_pixel_size(int *win_w, int *win_h)
     void
 mch_calc_cell_size(struct cellsize *cs_out)
 {
+# ifdef TIOCGWINSZ
    // get current tty size.
    struct winsize ws;
    int fd = 1;
    int retval = -1;
    retval = ioctl(fd, TIOCGWINSZ, &ws);
 
-# ifdef FEAT_EVAL
+#  ifdef FEAT_EVAL
    ch_log(NULL, "ioctl(TIOCGWINSZ) %s", retval == 0 ? "success" : "failed");
-# endif
+#  endif
 
    if (retval == -1 || ws.ws_col == 0 || ws.ws_row == 0)
    {
@@ -4570,6 +4571,12 @@ mch_calc_cell_size(struct cellsize *cs_out)
 # ifdef FEAT_EVAL
    ch_log(NULL, "Got cell pixel size with TIOCGWINSZ: %d x %d", x_cell_size, y_cell_size);
 # endif
+# else
+   // No TIOCGWINSZ on this platform (e.g. ESP-IDF). Report "unknown", which is
+   // exactly what the ioctl-failure path above reports.
+   cs_out->cs_xpixel = -1;
+   cs_out->cs_ypixel = -1;
+# endif
 }
 
